{% extends 'base.html.twig' %}

{% block title %}Gestion des tâches{% endblock %}

{% block body %}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Ma To-Do List</h1>

    <a href="{{ path('app_tache_ajouter') }}" class="btn btn-primary">
        + Ajouter une tâche
    </a>
</div>

{% if taches is empty %}

    <div class="alert alert-info">
        Aucune tâche disponible. Ajoutez votre première tâche !
    </div>

{% else %}

    <div class="list-group">

        {% for tache in taches %}

            <div class="list-group-item d-flex justify-content-between align-items-center">

                <div>
                    <h5 class="mb-1 {% if tache.terminee %}text-decoration-line-through text-muted{% endif %}">
                        {{ tache.titre }}
                    </h5>

                    <p class="mb-1 text-muted">
                        {{ tache.description }}
                    </p>

                    <small class="text-muted">
                        Créée le {{ tache.dateCreation|date('d/m/Y à H:i') }}
                    </small>
                </div>

                <div class="text-end">

                    {% if tache.terminee %}

                        <span class="badge bg-success">Terminée</span>

                    {% else %}

                        <span class="badge bg-warning text-dark">En cours</span>

                        <a href="{{ path('app_tache_terminer', {id: tache.id}) }}"
                           class="btn btn-sm btn-success ms-2">
                            Terminer
                        </a>

                    {% endif %}

                    <a href="{{ path('app_tache_detail', {id: tache.id}) }}"
                       class="btn btn-sm btn-outline-primary ms-2">
                        Détails
                    </a>

                </div>

            </div>

        {% endfor %}

    </div>

    <p class="mt-3 text-muted">
        Total : {{ taches|length }} tâche(s)
    </p>

{% endif %}

{% endblock %}