{% extends 'base.html.twig' %}

{% block title %}{{ categorie.nom }}{% endblock %}

{% block body %}

<div class="d-flex justify-content-between align-items-center mb-4">

    <h1>{{ categorie.nom }}</h1>

    <span class="badge bg-primary fs-6">
        {{ categorie.articles|length }} article(s)
    </span>

</div>

{% if categorie.description %}
    <p class="lead text-muted mb-4">
        {{ categorie.description }}
    </p>
{% endif %}

<hr>

<h3 class="mb-3">Articles de cette catégorie</h3>

{% if categorie.articles is empty %}

    <div class="alert alert-info">
        Aucun article dans cette catégorie.
    </div>

{% else %}

    <div class="list-group mb-4">

        {% for article in categorie.articles %}

            <a href="{{ path('app_article_detail', {id: article.id}) }}"
               class="list-group-item list-group-item-action">

                <strong>{{ article.titre }}</strong>

                <small class="text-muted d-block">
                    Par {{ article.auteur }}
                </small>

            </a>

        {% endfor %}

    </div>

{% endif %}

<div class="d-flex gap-2 flex-wrap">

    <a href="{{ path('app_categorie_modifier', {id: categorie.id}) }}"
       class="btn btn-primary">
        Modifier
    </a>

    <form method="post"
          action="{{ path('app_categorie_supprimer', {id: categorie.id}) }}"
          onsubmit="return confirm('Voulez-vous vraiment supprimer cette catégorie ?');">

        <input type="hidden"
               name="_token"
               value="{{ csrf_token('supprimer_categorie_' ~ categorie.id) }}">

        <button type="submit" class="btn btn-danger">
            Supprimer
        </button>

    </form>

    {# Bonus : créer directement un article dans cette catégorie #}
    <a href="{{ path('app_article_nouveau', {categorie: categorie.id}) }}"
       class="btn btn-success">
        + Créer un article dans cette catégorie
    </a>

    <a href="{{ path('app_categories') }}"
       class="btn btn-outline-secondary">
        Retour aux catégories
    </a>

</div>

{% endblock %}